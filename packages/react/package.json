{
  "name": "@adrian-danciu/ink-ui",
  "version": "0.1.0",
  "description": "Brutalist React and Next.js components with three themes, light and dark modes, and configurable accents.",
  "license": "MIT",
  "keywords": ["react", "nextjs", "components", "design-system", "brutalism", "ink-ui"],
  "repository": { "type": "git", "url": "git+https://github.com/adrian-danciu/ink-ui.git", "directory": "packages/react" },
  "homepage": "https://github.com/adrian-danciu/ink-ui#readme",
  "bugs": { "url": "https://github.com/adrian-danciu/ink-ui/issues" },
  "type": "module",
  "files": ["dist", "styles.css", "styles/base.css", "src/ThemeProvider/style.css", "src/components/*/style.css", "README.md", "LICENSE"],
  "sideEffects": ["./styles.css", "./styles/base.css", "./src/ThemeProvider/style.css", "./src/components/*/style.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "bun x --bun tsup src/index.tsx --format esm,cjs --dts --clean",
    "typecheck": "bun x --bun tsc -p tsconfig.json"
  },
  "dependencies": { "@adrian-danciu/ink-ui-tokens": "^0.1.0" },
  "peerDependencies": { "react": ">=18.2 <20", "react-dom": ">=18.2 <20" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": { "access": "public" }
}

{
  "name": "@ui-library/tokens",
  "version": "0.0.0",
  "type": "module",
  "files": ["dist", "styles.css"],
  "sideEffects": ["./styles.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "bun scripts/generate-css.mjs && bun x --bun tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": { "access": "public" }
}

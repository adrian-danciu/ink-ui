{
  "name": "@adrian-danciu/ink-ui-tokens",
  "version": "0.1.0",
  "description": "Shared design tokens and CSS variables for Ink UI's React and React Native components.",
  "license": "MIT",
  "keywords": ["design-tokens", "css-variables", "react", "react-native", "ink-ui"],
  "repository": { "type": "git", "url": "git+https://github.com/adrian-danciu/ink-ui.git", "directory": "packages/tokens" },
  "homepage": "https://github.com/adrian-danciu/ink-ui#readme",
  "bugs": { "url": "https://github.com/adrian-danciu/ink-ui/issues" },
  "type": "module",
  "files": ["dist", "styles.css", "README.md", "LICENSE"],
  "sideEffects": ["./styles.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "bun scripts/generate-css.mjs && bun x --bun tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": { "access": "public" }
}
